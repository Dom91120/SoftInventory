// ════════════════════════════════════════════════════════════════════════════
//  SoftInventory — schéma Prisma
//
//  Conventions (héritées de culturesa-next) :
//  - Modèles PascalCase, tables @@map("snake_case") ; champs camelCase,
//    colonnes @map("snake_case") quand le nom diffère.
//  - Horodatages en @db.Timestamptz, dates métier en @db.Date.
//  - onDelete explicite sur chaque relation ; @@index sur chaque clé étrangère.
//  - Ids Int autoincrement pour les tables métier ; String cuid pour les tables
//    Better Auth (leur forme fait contrat avec la bibliothèque).
// ════════════════════════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // L'URL vit dans prisma.config.ts (process.env.DATABASE_URL) : `prisma generate`
  // ne doit jamais échouer faute de base joignable.
}

// ============================================================
//  Enums
// ============================================================

/// Deux niveaux seulement : l'application est interne à la DSI.
/// `lecteur` consulte tout ; `admin` gère tout (inventaire, référentiels, comptes).
enum Role {
  lecteur
  admin
}

/// Mode d'hébergement d'un logiciel.
enum Hebergement {
  saas
  on_premise
  hybride
}

/// Position dans le cycle de vie.
enum CycleDeVie {
  evaluation
  production
  fin_de_vie
  abandonne
}

/// Modèle de diffusion.
enum TypeSource {
  opensource
  proprietaire
  mixte
}

/// Comment les utilisateurs s'authentifient dans le logiciel.
/// « Mixte » était trop court pour ce qu'il désigne : plusieurs portes sur le
/// même logiciel, et c'est LAQUELLE s'ajoute aux comptes locaux qui compte —
/// fermer un compte d'annuaire ne suffit pas de la même façon selon qu'on a
/// affaire à l'AD ou à un fournisseur d'identité.
enum ModeAuthentification {
  locale
  sso
  ldap
  mixte_ldap
  mixte_sso
  aucune
}

/// Où les données du logiciel sont hébergées (volet RGPD).
enum LocalisationDonnees {
  ue
  hors_ue
  mixte
  inconnue
}

/// Habillage des statuts du cycle de vie : le LIBELLÉ et la COULEUR sont
/// administrables, la clé ne l'est pas. Les quatre clés pilotent la logique
/// (filtres, rappels, export) et restent portées par l'enum `CycleDeVie` :
/// pouvoir en ajouter ou en supprimer laisserait des fiches orphelines.
model StatutLogiciel {
  id       Int        @id @default(autoincrement())
  cle      CycleDeVie @unique
  label    String
  couleur  String     @default("#94a3b8")
  position Int        @default(0)

  @@map("statuts_logiciels")
}

/// Habillage des modes d'hébergement, sur le même principe que `StatutLogiciel` :
/// le libellé, la couleur et l'ordre s'administrent, la clé non. Les trois clés
/// sont portées par l'enum `Hebergement` et servent aux filtres et à l'export.
model ModeHebergement {
  id       Int         @id @default(autoincrement())
  cle      Hebergement @unique
  label    String
  couleur  String      @default("#94a3b8")
  position Int         @default(0)

  @@map("modes_hebergement")
}

/// Nature d'une ligne de contrat.
enum TypeContrat {
  perpetuelle
  abonnement
  libre
  autre
}

/// Ce qu'est l'acte : un marché public passé après publicité et mise en
/// concurrence, ou un contrat de gré à gré. Distinct de `TypeContrat`, qui
/// qualifiait le mode de licence d'une PIÈCE.
enum NatureMarche {
  marche
  contrat
}

// ============================================================
//  Authentification (Better Auth) — formes contractuelles
// ============================================================

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  emailVerified Boolean  @default(false)
  name          String   @default("")
  image         String?
  createdAt     DateTime @default(now()) @db.Timestamptz
  updatedAt     DateTime @updatedAt @db.Timestamptz

  // Champs métier additionnels (déclarés aussi dans server/auth.ts + lib/auth-client.ts)
  prenom           String    @default("")
  nom              String    @default("")
  tel              String    @default("")
  role             Role      @default(lecteur)
  twoFactorEnabled Boolean   @default(false) @map("two_factor_enabled")
  lastLoginAt      DateTime? @map("last_login_at") @db.Timestamptz
  // Compte provisionné depuis l'annuaire LDAP/AD : son rôle suit le mapping des
  // groupes à chaque connexion, et il n'a pas de mot de passe local.
  ldap             Boolean   @default(false)

  sessions        Session[]
  accounts        Account[]
  twoFactors      TwoFactor[]
  tachesAssignees TacheRecurrente[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime @db.Timestamptz
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz
  refreshTokenExpiresAt DateTime? @db.Timestamptz
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @db.Timestamptz
  updatedAt             DateTime  @updatedAt @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz
  createdAt  DateTime @default(now()) @db.Timestamptz
  updatedAt  DateTime @updatedAt @db.Timestamptz

  @@index([identifier])
  @@map("verification")
}

// Second facteur TOTP. Schéma imposé par le plugin twoFactor de Better Auth :
// les NOMS DE CHAMPS Prisma font contrat avec lui, seuls les noms de colonnes
// sont libres. `id` est indispensable : l'adaptateur en génère un pour tout
// enregistrement créé (son absence casse l'écriture — leçon de culturesa-next).
model TwoFactor {
  id                      String    @id @default(cuid())
  secret                  String
  backupCodes             String    @map("backup_codes")
  userId                  String    @map("user_id")
  verified                Boolean   @default(true)
  failedVerificationCount Int       @default(0) @map("failed_verification_count")
  lockedUntil             DateTime? @map("locked_until") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([secret])
  @@index([userId])
  @@map("two_factor")
}

// Quota par IP de Better Auth, persisté en base (un redémarrage ne remet pas les
// compteurs à zéro). `id` INDISPENSABLE : l'adaptateur Prisma de Better Auth en
// génère un pour tout enregistrement — sans lui, toute connexion échoue.
model RateLimit {
  id          String @id @default(cuid())
  key         String @unique
  count       Int    @default(0)
  lastRequest BigInt @default(0) @map("last_request")

  @@map("rate_limits")
}

// Freinage PAR COMPTE des échecs de connexion (complète le quota par IP :
// l'un borne une machine qui martèle, l'autre le password spraying).
model LoginAttempt {
  emailHash     String    @id @map("email_hash")
  failures      Int       @default(0) @db.SmallInt
  lockedUntil   DateTime? @map("locked_until") @db.Timestamptz
  lastFailureAt DateTime  @default(now()) @map("last_failure_at") @db.Timestamptz

  // Purge des compteurs périmés (tâche de rétention).
  @@index([lastFailureAt])
  @@map("login_attempts")
}

/// Seaux de limitation de débit hors Better Auth. Fenêtre fixe : `count` remis
/// à 1 quand `resetAt` est dépassé. La clé porte sa portée (`xxx:<ip>`).
model ThrottleBucket {
  key     String   @id
  count   Int      @default(0)
  resetAt DateTime @map("reset_at") @db.Timestamptz

  @@index([resetAt])
  @@map("throttle_buckets")
}

// ============================================================
//  Référentiels éditables
//
//  Tables plutôt qu'enums : un admin non-développeur doit pouvoir ajouter une
//  technologie, un niveau de criticité ou un type de tâche sans redéploiement.
//  Les enums restent réservés aux ensembles fermés porteurs de logique.
// ============================================================

/// Éditeur/fournisseur d'un logiciel, avec ses canaux de support : le support
/// (portail de tickets, mail, téléphone, horaires) vit AU NIVEAU ÉDITEUR — un
/// même fournisseur assure le support de tous ses produits.
model Editeur {
  id                   Int      @id @default(autoincrement())
  nom                  String   @unique
  adresse              String   @default("")
  codePostal           String   @default("") @map("code_postal")
  ville                String   @default("")
  telephone            String   @default("")
  email                String   @default("")
  siteWeb              String   @default("") @map("site_web")
  supportUrl           String   @default("") @map("support_url")
  supportEmail         String   @default("") @map("support_email")
  supportTelephone     String   @default("") @map("support_telephone")
  /// Le numéro que l'ÉDITEUR nous a attribué et qu'il redemande à chaque appel.
  /// Il vit avec les canaux d'assistance parce que c'est là qu'on le cherche,
  /// juste avant de composer le numéro.
  numeroClient         String   @default("") @map("numero_client")
  /// Les horaires tiennent sur DEUX lignes parce qu'ils décrivent presque
  /// toujours deux régimes — « lundi au vendredi 8h-17h » puis « samedi
  /// 8h-12h ». Une seule ligne obligeait à les coudre avec un tiret ou une
  /// barre, chaque fiche inventant sa ponctuation. La seconde reste vide quand
  /// la semaine est d'un bloc.
  supportHoraires      String   @default("") @map("support_horaires")
  supportHoraires2     String   @default("") @map("support_horaires_2")
  /// Contacts hors support : le commercial pour l'offre et le renouvellement,
  /// l'administratif pour la facturation. Chacun porte le NOM de la personne
  /// puis ses coordonnées. Distincts des `telephone`/`email` du standard, qui
  /// restent ceux de la société.
  commercialContact    String   @default("") @map("commercial_contact")
  commercialTelephone  String   @default("") @map("commercial_telephone")
  commercialEmail      String   @default("") @map("commercial_email")
  /// Un SECOND commercial, fréquent chez les éditeurs qui séparent le
  /// renouvellement de l'avant-vente, ou qui doublent l'interlocuteur pendant
  /// une passation. Ses trois champs restent vides sinon.
  commercialContact2   String   @default("") @map("commercial_contact_2")
  commercialTelephone2 String   @default("") @map("commercial_telephone_2")
  commercialEmail2     String   @default("") @map("commercial_email_2")
  adminContact         String   @default("") @map("admin_contact")
  adminTelephone       String   @default("") @map("admin_telephone")
  adminEmail           String   @default("") @map("admin_email")
  /// Le délégué à la protection des données de l'ÉDITEUR — celui à qui écrire
  /// pour une violation ou une demande d'exercice de droits sur les données
  /// qu'il héberge. Distinct du DPO de la collectivité, qui n'a pas sa place
  /// dans un annuaire de fournisseurs.
  dpoContact           String   @default("") @map("dpo_contact")
  dpoTelephone         String   @default("") @map("dpo_telephone")
  dpoEmail             String   @default("") @map("dpo_email")
  notes                String   @default("")
  createdAt            DateTime @default(now()) @db.Timestamptz
  updatedAt            DateTime @updatedAt @db.Timestamptz

  logiciels       Logiciel[]
  documents       Document[]
  /// Contrats où cette société est le FOURNISSEUR — celle avec qui la
  /// collectivité contractualise. C'est souvent l'éditeur du logiciel, mais un
  /// revendeur (Metsys pour Semperis, Delta Industrie Service pour TX-Visio…)
  /// a lui aussi sa fiche ici : la table est un annuaire de sociétés.
  contratsFournis Contrat[]    @relation("ContratFournisseur")
  /// Devis remis par cette société lors des mises en concurrence.
  devisRemis      Devis[]      @relation("DevisFournisseur")
  /// Certificats délivrés par cette société — les autorités de certification
  /// (Certinomis, ChamberSign) sont des fournisseurs comme les autres.
  certificats     Certificat[] @relation("CertificatFournisseur")

  @@map("editeurs")
}

/// Service utilisateur (direction/service de la collectivité qui utilise un
/// logiciel) : état civil, urbanisme, finances, RH…
model ServiceUtilisateur {
  id               Int    @id @default(autoincrement())
  nom              String @unique
  contactNom       String @default("") @map("contact_nom")
  contactEmail     String @default("") @map("contact_email")
  contactTelephone String @default("") @map("contact_telephone")
  position         Int    @default(0) @db.SmallInt

  logiciels   LogicielService[]
  certificats Certificat[]

  @@map("services_utilisateurs")
}

/// Famille du système : ce qui décide des outils d'administration et des
/// habitudes d'exploitation. La VERSION exacte reste dans `os`, en clair.
/// Vide = non renseigné, d'où l'absence de valeur par défaut.
enum TypeOs {
  windows
  linux
}

/// Serveur d'hébergement (interne ou hébergé) sur lequel des logiciels tournent.
model Serveur {
  id  Int    @id @default(autoincrement())
  nom String @unique
  /// Machine virtuelle plutôt que matériel dédié. Vrai par défaut : le parc
  /// est virtualisé, et c'est la machine physique qui fait exception.
  virtuel Boolean @default(true)
  /// null = non renseigné : personne n'est obligé de trancher, et le parc
  /// repris de l'existant n'a pas été dépouillé sur ce point.
  typeOs       TypeOs? @map("type_os")
  os           String  @default("")
  localisation String  @default("") // salle serveur, datacenter, hébergeur…
  notes        String  @default("")

  logiciels   LogicielServeur[]
  certificats Certificat[]

  @@map("serveurs")
}

/// Type d'architecture applicative : web, client-serveur, mobile…
model Technologie {
  id       Int    @id @default(autoincrement())
  label    String @unique
  position Int    @default(0) @db.SmallInt

  logiciels Logiciel[]

  @@map("technologies")
}

/// Niveau de criticité. `rank` ordonne du moins grave au plus grave (tri +
/// tableau de bord) ; `couleur` alimente les badges (hex).
model Criticite {
  id          Int    @id @default(autoincrement())
  label       String @unique
  rank        Int    @default(0) @db.SmallInt
  couleur     String @default("")
  description String @default("")

  logiciels Logiciel[]

  @@map("criticites")
}

/// Type de tâche récurrente : mise à jour, renouvellement de contrat, purge…
model TypeTache {
  id       Int    @id @default(autoincrement())
  label    String @unique
  position Int    @default(0) @db.SmallInt

  taches TacheRecurrente[]

  @@map("types_taches")
}

/// Catégorie de pièce jointe : contrat, guide, délibération, arrêté…
model CategorieDocument {
  id       Int    @id @default(autoincrement())
  label    String @unique
  position Int    @default(0) @db.SmallInt

  documents Document[]

  @@map("categories_documents")
}

// ============================================================
//  Cœur métier : l'inventaire des logiciels
// ============================================================

/// Un logiciel du parc. Les FK de qualification (éditeur, technologie,
/// criticité) sont en SetNull : supprimer une valeur de référentiel ne doit
/// jamais détruire une fiche d'inventaire.
model Logiciel {
  id          Int    @id @default(autoincrement())
  nom         String
  description String @default("")

  editeurId            Int?     @map("editeur_id")
  editeur              Editeur? @relation(fields: [editeurId], references: [id], onDelete: SetNull)
  /// Application faite et maintenue par la DSI : il n'y a pas d'éditeur, donc
  /// pas de fiche société, de support ni de contrat à lui rattacher. Portée par
  /// le logiciel plutôt que par un éditeur sentinelle « Développement interne »,
  /// qui polluait l'annuaire et les listes de fournisseurs.
  developpementInterne Boolean  @default(false) @map("developpement_interne")

  /// Ce logiciel ne s'installe sur AUCUNE machine du parc : il tourne chez
  /// l'éditeur (SaaS) ou sur les postes des agents. Sans ce marqueur, une fiche
  /// sans serveur ne se distinguait pas d'une fiche dont le serveur reste à
  /// saisir, et la complétude allait chercher du travail là où il n'y en avait
  /// pas — 32 % annoncés pour un champ qui ne concernait que la moitié du parc.
  /// Même parti que `developpementInterne` : l'information est portée par le
  /// logiciel, plutôt que par une machine sentinelle « Aucun » qui aurait
  /// pollué le parc et tous ses décomptes.
  sansServeur   Boolean      @default(false) @map("sans_serveur")

  hebergement   Hebergement  @default(on_premise)
  technologieId Int?         @map("technologie_id")
  technologie   Technologie? @relation(fields: [technologieId], references: [id], onDelete: SetNull)
  criticiteId   Int?         @map("criticite_id")
  criticite     Criticite?   @relation(fields: [criticiteId], references: [id], onDelete: SetNull)

  typeSource TypeSource @default(proprietaire) @map("type_source")
  statut     CycleDeVie @default(production)

  versionInstallee  String               @default("") @map("version_installee")
  /// Lien vers le produit quand il est accessible en mode web (cliquable
  /// depuis la liste et la fiche).
  url               String               @default("")
  dateMiseEnService DateTime?            @map("date_mise_en_service") @db.Date
  /// null = non renseigné. PAS de valeur par défaut : « locale » s'écrivait sur
  /// toute fiche créée, et 84 des 85 logiciels l'affirmaient sans que personne
  /// l'ait saisi — au point que l'écran Statistiques écartait le champ de ses
  /// répartitions. Mieux vaut un vide qui se voit qu'une réponse inventée.
  authentification  ModeAuthentification?
  /// Second facteur exigé à la connexion (2FA / MFA). Faux par défaut, et ce
  /// défaut-là ne ment pas : la double authentification est encore l'exception,
  /// et c'est la cocher qui est une information.
  authentificationForte Boolean @default(false) @map("authentification_forte")
  /// Nombre d'utilisateurs réels ; null = NON COMPTÉ. La distinction compte :
  /// un logiciel à zéro utilisateur est un candidat au retrait, un logiciel
  /// non compté n'est qu'un trou dans l'inventaire.
  nbUtilisateurs    Int?                 @map("nb_utilisateurs")
  /// Plafond d'utilisateurs prévu au contrat ; null = illimité ou non
  /// renseigné → jamais de dépassement. Porté par le logiciel et non par la
  /// ligne de contrat : c'est la valeur que l'on compare à `nbUtilisateurs`.
  nbMaxUtilisateurs Int?                 @map("nb_max_utilisateurs")
  referentMetier    String               @default("") @map("referent_metier")
  referentTechnique String               @default("") @map("referent_technique")
  /// Remplace, quand elle est renseignée, le « Aucun contrat enregistré » de
  /// l'onglet Contrats. Certaines fiches n'auront jamais de marché ICI parce
  /// qu'il est porté ailleurs — « Contrat géré par le CCAS » — et sans ce mot
  /// le vide se lisait comme un trou dans l'inventaire. Vide = message
  /// standard ; sans objet dès qu'un marché est rattaché.
  mentionSansContrat String              @default("") @map("mention_sans_contrat")

  // ── Volet RGPD (simple) ──
  donneesPersonnelles Boolean             @default(false) @map("donnees_personnelles")
  categoriesDonnees   String              @default("") @map("categories_donnees")
  registreRef         String              @default("") @map("registre_ref")
  localisationDonnees LocalisationDonnees @default(inconnue) @map("localisation_donnees")

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  services              LogicielService[]
  serveurs              LogicielServeur[]
  contrats              ContratLogiciel[]
  consultations         Consultation[]
  documents             Document[]
  taches                TacheRecurrente[]
  interconnexionsSource Interconnexion[]  @relation("ixSource")
  interconnexionsCible  Interconnexion[]  @relation("ixCible")

  @@index([editeurId])
  @@index([technologieId])
  @@index([criticiteId])
  @@index([statut])
  @@index([nom])
  @@map("logiciels")
}

/// N-N logiciel ↔ service utilisateur.
model LogicielService {
  logicielId Int @map("logiciel_id")
  serviceId  Int @map("service_id")

  logiciel Logiciel           @relation(fields: [logicielId], references: [id], onDelete: Cascade)
  service  ServiceUtilisateur @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([logicielId, serviceId])
  @@index([serviceId])
  @@map("logiciels_services")
}

/// N-N logiciel ↔ serveur, qualifié par l'environnement : un même logiciel
/// peut être installé sur le même serveur en prod ET en test.
/// « Ce logiciel est installé sur cette machine », et rien de plus. La ligne
/// portait aussi un environnement (production / test / recette / formation) :
/// les trente installations de l'inventaire disaient toutes « production », le
/// champ n'a jamais servi. Il coûtait une pastille sur chaque ligne de chaque
/// écran et une liste à renseigner à chaque association, pour une information
/// que le STATUT du logiciel donne déjà, en un seul endroit.
model LogicielServeur {
  logicielId Int @map("logiciel_id")
  serveurId  Int @map("serveur_id")

  logiciel Logiciel @relation(fields: [logicielId], references: [id], onDelete: Cascade)
  serveur  Serveur  @relation(fields: [serveurId], references: [id], onDelete: Cascade)

  @@id([logicielId, serveurId])
  @@index([serveurId])
  @@map("logiciels_serveurs")
}

/// Flux orienté entre deux logiciels (ex. « export paie mensuel vers X »).
/// La fiche d'un logiciel affiche les DEUX sens.
model Interconnexion {
  id          Int    @id @default(autoincrement())
  sourceId    Int    @map("source_id")
  cibleId     Int    @map("cible_id")
  description String @default("")

  source Logiciel @relation("ixSource", fields: [sourceId], references: [id], onDelete: Cascade)
  cible  Logiciel @relation("ixCible", fields: [cibleId], references: [id], onDelete: Cascade)

  @@unique([sourceId, cibleId])
  @@index([cibleId])
  @@map("interconnexions")
}

/// Un contrat ou marché passé pour un logiciel : ce qui l'IDENTIFIE — son
/// libellé, sa référence, la société avec qui on s'engage — et ce qui l'engage
/// GLOBALEMENT : son montant annuel et sa date de fin.
///
/// Ces deux-là ne font pas double emploi avec ceux des pièces : la pièce dit ce
/// que coûte UN poste et quand il se renouvelle, le marché dit ce qu'il pèse en
/// tout et jusqu'à quand il court. Un même marché couvre souvent plusieurs
/// postes aux coûts et aux termes distincts, sans que leur somme ni leur
/// échéance la plus lointaine valent engagement.
model Contrat {
  id                   Int           @id @default(autoincrement())
  /// Société avec qui la collectivité contractualise. null = l'éditeur du
  /// logiciel, cas le plus fréquent ; renseigné quand c'est un revendeur.
  fournisseurId        Int?          @map("fournisseur_id")
  /// Marché ou contrat. null = non renseigné : les lignes reprises de
  /// l'historique n'ont pas été dépouillées sur ce point, et rien ne permet
  /// de trancher à leur place — l'écran dit « — » plutôt qu'une supposition.
  nature               NatureMarche?
  libelle              String        @default("") // ex. « marché 2024-12 », « pack 50 postes »
  referenceMarche      String        @default("") @map("reference_marche")
  /// La référence que LE FOURNISSEUR donne au même acte — son numéro de
  /// commande, de contrat ou de client pour cette affaire. Distincte de
  /// `referenceMarche`, qui est celle de la collectivité : c'est celle-ci qu'il
  /// faut citer quand on l'appelle, et personne ne la retrouvait.
  referenceFournisseur String        @default("") @map("reference_fournisseur")
  /// Montant annuel du marché entier. null = non renseigné, à distinguer de
  /// zéro (un marché à titre gratuit se saisit, lui, à 0).
  montantAnnuel        Decimal?      @map("montant_annuel") @db.Decimal(12, 2)
  /// Maximum ANNUEL : le plafond que le marché ne peut pas dépasser sur une
  /// année, quand l'acte en fixe un. Aucune contrainte avec `montantAnnuel`,
  /// qui dit ce qu'on paie : c'est l'acte qui fait foi, et un montant au-delà
  /// du plafond se saisit — le signaler est un autre sujet que le stocker.
  montantMaxi          Decimal?      @map("montant_maxi") @db.Decimal(12, 2)
  /// Ce que pèse le marché sur sa DURÉE ENTIÈRE, quand l'acte le chiffre.
  /// N'entre pas dans le coût du parc, qui se compte à l'année — l'y ajouter
  /// gonflerait le total d'un marché pluriannuel autant de fois qu'il dure.
  montantTotal         Decimal?      @map("montant_total") @db.Decimal(12, 2)
  /// Début du marché : la date à laquelle il prend effet. Se lit avec dateFin,
  /// dont elle forme la période affichée (« du … au … »). Indépendante d'elle :
  /// un marché en cours a souvent un début connu et un terme qui ne l'est pas.
  dateDebut            DateTime?     @map("date_debut") @db.Date
  /// Terme du marché, et ÉCHÉANCE surveillée : c'est cette date que le cron
  /// lit pour ses rappels et le tableau de bord pour ses renouvellements. Le
  /// suivi vivait sur la pièce ; il est remonté ici, une pièce ne portant plus
  /// qu'une date de document.
  dateFin              DateTime?     @map("date_fin") @db.Date
  /// Durée FERME du marché, en années (1 à 4), telle que l'acte la fixe. Ne se
  /// déduit pas des dates et n'en découle pas : la période court du début à la
  /// fin reconductions comprises, la durée ferme est l'engagement initial.
  /// null = non renseigné.
  dureeAnnees          Int?          @map("duree_annees")
  /// Nombre de reconductions prévues (0 à 3) : « renouvelable n fois ». Zéro
  /// est une VALEUR — un marché sec, non reconductible — distinct de null, qui
  /// dit que l'acte n'a pas été dépouillé sur ce point.
  renouvellements      Int?
  /// Date de fin pour laquelle le rappel a déjà été envoyé (anti-doublon du
  /// cron ; remise à null quand la date change).
  rappelEnvoyeLe       DateTime?     @map("rappel_envoye_le") @db.Date
  notes                String        @default("")
  createdAt            DateTime      @default(now()) @db.Timestamptz

  // Le fournisseur n'est pas propriétaire du contrat : supprimer sa fiche ne
  // doit pas emporter le contrat, seulement le laisser sans fournisseur.
  fournisseur Editeur?          @relation("ContratFournisseur", fields: [fournisseurId], references: [id], onDelete: SetNull)
  pieces      PieceContrat[]
  /// Logiciels couverts. Un marché en couvre souvent PLUSIEURS (UGAP, marchés
  /// « communs ») : il vit donc pour lui-même, avec sa propre fiche, et n'est
  /// plus une dépendance du logiciel.
  logiciels   ContratLogiciel[]

  @@index([fournisseurId])
  @@index([dateFin])
  @@map("contrats")
}

/// Rattachement d'un marché aux logiciels qu'il couvre. Table de liaison nue :
/// le lien ne porte rien de son côté — ni montant ni date, tout appartient au
/// marché.
///
/// Les deux cascades sont volontaires et asymétriques dans leur EFFET : elles
/// n'effacent que le LIEN. Supprimer un logiciel ne supprime donc plus les
/// marchés qui le couvraient (ils en couvrent peut-être d'autres) ; un marché
/// qui perd son dernier logiciel survit, sans rattachement, et se voit dans la
/// liste des marchés — à l'utilisateur de le supprimer s'il n'a plus lieu
/// d'être. Effacer un acte contractuel par ricochet serait pire.
model ContratLogiciel {
  contratId  Int @map("contrat_id")
  logicielId Int @map("logiciel_id")

  contrat  Contrat  @relation(fields: [contratId], references: [id], onDelete: Cascade)
  logiciel Logiciel @relation(fields: [logicielId], references: [id], onDelete: Cascade)

  @@id([contratId, logicielId])
  @@index([logicielId])
  @@map("contrats_logiciels")
}

/// Une pièce d'un contrat ou marché : un poste, son coût et la date de son
/// document, avec le fichier qui l'atteste. Elle alimente le coût annuel du
/// tableau de bord, mais ne porte plus d'échéance : le rappel de
/// renouvellement surveille désormais Contrat.dateFin.
model PieceContrat {
  id         Int         @id @default(autoincrement())
  contratId  Int         @map("contrat_id")
  type       TypeContrat @default(abonnement)
  coutAnnuel Decimal?    @map("cout_annuel") @db.Decimal(12, 2)
  /// Date du document lui-même — sa signature, sa notification. Presque
  /// toujours PASSÉE, d'où l'absence de tout rappel accroché : la colonne
  /// portait auparavant la date de renouvellement, dont elle a hérité les
  /// valeurs.
  datePiece  DateTime?   @map("date_piece") @db.Date
  createdAt  DateTime    @default(now()) @db.Timestamptz

  contrat   Contrat    @relation(fields: [contratId], references: [id], onDelete: Cascade)
  documents Document[]

  @@index([contratId])
  @@index([datePiece])
  @@map("pieces_contrat")
}

// ============================================================
//  Mise en concurrence
// ============================================================

/// Une mise en concurrence sur un logiciel : l'objet consulté (renouvellement,
/// migration, première acquisition…) et les devis reçus. Un logiciel en
/// accumule plusieurs au fil des années — d'où ce niveau intermédiaire plutôt
/// qu'une liste plate de devis, qui ne saurait pas dire QUEL devis a été retenu
/// POUR QUELLE consultation.
model Consultation {
  id         Int       @id @default(autoincrement())
  logicielId Int       @map("logiciel_id")
  objet      String
  /// Date de la consultation ; sert au tri (la plus récente en tête).
  date       DateTime? @db.Date
  createdAt  DateTime  @default(now()) @db.Timestamptz

  logiciel Logiciel @relation(fields: [logicielId], references: [id], onDelete: Cascade)
  devis    Devis[]

  @@index([logicielId])
  @@map("consultations")
}

/// Devis reçu dans le cadre d'une consultation. `retenu` marque celui qui a été
/// choisi : AU PLUS UN par consultation, invariant tenu par le service
/// (marquerDevisRetenu) et non par la base — PostgreSQL le dirait avec un index
/// unique partiel, que Prisma ne sait pas déclarer et effacerait à la migration
/// suivante.
model Devis {
  id             Int       @id @default(autoincrement())
  consultationId Int       @map("consultation_id")
  /// Société qui a remis le devis. null = non renseignée ; SetNull pour que la
  /// suppression d'une fiche société n'emporte pas l'historique de la consultation.
  fournisseurId  Int?      @map("fournisseur_id")
  montant        Decimal?  @db.Decimal(12, 2)
  date           DateTime? @db.Date
  retenu         Boolean   @default(false)
  createdAt      DateTime  @default(now()) @db.Timestamptz

  consultation Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  fournisseur  Editeur?     @relation("DevisFournisseur", fields: [fournisseurId], references: [id], onDelete: SetNull)
  documents    Document[]

  @@index([consultationId])
  @@index([fournisseurId])
  @@map("devis")
}

// ============================================================
//  Certificats électroniques
// ============================================================

/// Ce que le certificat permet de faire. Un même titulaire en porte parfois
/// deux — un pour signer, un pour s'authentifier — d'où une fiche par
/// certificat et non par personne.
/// Civilité du titulaire d'un certificat. Séparée du nom plutôt que collée
/// devant lui : « M. » n'est pas un bout du patronyme, et la tenir à part rend
/// le tri et la recherche justes — « Mme AZZAZ » se rangeait sous M, avec les
/// dix-sept autres. NULLE quand il n'y a personne à nommer : un certificat de
/// machine (« SERVEUR CLIENT RGS ») n'a pas de civilité, et lui en inventer une
/// serait pire que la laisser vide.
enum Civilite {
  m
  mme
}

enum UsageCertificat {
  signature
  authentification
  cachet
  autre
}

/// Ce qui porte la clé privée. La distinction n'est pas cosmétique : une carte
/// ou une clé USB se restituent en fin de vie et se perdent, un fichier logiciel
/// se copie et ne se rend pas.
enum SupportCertificat {
  carte
  cle_usb
  logiciel
  autre
}

/// Ce qu'on a DÉCIDÉ du certificat — et rien de ce que les dates disent déjà.
/// Un certificat révoqué avant terme n'est plus utilisable alors que sa date
/// court encore ; un certificat suspendu le redeviendra, et son échéance
/// continue donc de compter.
///
/// « Expiré » n'en est pas : il SE DÉDUIT de la date de fin, et en faire un
/// choix de liste ouvrait deux façons de dire la même chose — qui pouvaient
/// se contredire. Les écrans le calculent (voir `pastilleValidite`).
///
/// « En renouvellement » a disparu de même : il décrivait une commande en
/// cours, pas l'état du certificat.
enum StatutCertificat {
  valide
  revoque
  suspendu
}

/// Certificat électronique nominatif (élu, agent) ou de serveur.
///
/// Ni un logiciel ni un contrat, mais un peu des deux : il se renouvelle comme
/// un marché, il porte une échéance à surveiller comme une tâche, et il se
/// rattache à un service comme une application. D'où sa propre table, avec la
/// même mécanique de rappel que les contrats (`rappelEnvoyeLe`).
model Certificat {
  id            Int  @id @default(autoincrement())
  /// L'autorité de certification, prise dans l'annuaire des sociétés — c'est
  /// bien un fournisseur, avec son adresse et ses contacts, et rien ne justifie
  /// un second annuaire pour Certinomis et ChamberSign.
  fournisseurId Int? @map("fournisseur_id")
  /// Le service auquel le certificat est rattaché. Renseigné pour les agents,
  /// souvent vide pour les élus, qui n'en relèvent pas.
  serviceId     Int? @map("service_id")
  /// Le serveur qu'il équipe, pour un certificat de machine (cachet, TLS).
  /// null pour un certificat nominatif, le cas courant.
  serveurId     Int? @map("serveur_id")

  /// Civilité du titulaire, DEVANT son nom sur la fiche comme dans la liste.
  /// Nulle pour un certificat de machine.
  civilite  Civilite?
  /// Qui le porte : une personne (« AZZAZ ») ou une machine (« SERVEUR CLIENT
  /// RGS »). Texte libre et non un compte de l'application : les élus n'en ont
  /// pas, et un certificat survit au compte de son titulaire. Le NOM seul —
  /// la civilité et le prénom ont chacun leur colonne.
  titulaire String
  /// Le prénom, à part du nom pour la même raison que la civilité : c'est le
  /// NOM qui trie et qui se cherche. Vide pour une machine, et vide tant qu'on
  /// ne l'a pas saisi — l'inventaire n'a longtemps porté que des patronymes.
  prenom    String @default("")
  /// La qualité au titre de laquelle il signe — Maire, Adjoint, DGA, Agent.
  /// C'est elle qui donne sa portée juridique à la signature, pas le service.
  fonction  String @default("")
  email     String @default("")

  usage       UsageCertificat?
  support     SupportCertificat?
  /// Niveau de garantie tel que l'atteste l'autorité : « RGS** », « eIDAS
  /// qualifié »… Texte libre plutôt qu'énuméré, les appellations changeant au
  /// rythme des référentiels et non à celui de l'application.
  niveau      String             @default("")
  /// Numéro de série porté par le certificat lui-même : ce qui l'identifie
  /// auprès de l'autorité, à citer pour une révocation ou une réclamation.
  numeroSerie String             @default("") @map("numero_serie")

  /// Début et fin de validité. La FIN est l'échéance surveillée : c'est elle
  /// que le cron lit pour ses rappels. Le fichier d'origine les tenait dans une
  /// seule colonne de texte (« du … au … »), qui n'a permis ni tri ni alerte —
  /// et où quatre coquilles s'étaient glissées.
  dateDebut   DateTime? @map("date_debut") @db.Date
  dateFin     DateTime? @map("date_fin") @db.Date
  /// Durée de validité en années (1 à 5). Ne se déduit pas des dates : elle dit
  /// ce qui a été commandé, quand les dates disent ce qui a été délivré.
  dureeAnnees Int?      @map("duree_annees")

  montantTtc Decimal? @map("montant_ttc") @db.Decimal(12, 2)
  /// Imputation budgétaire (« 60632 »), telle que la comptabilité la réclame
  /// pour le bon de commande.
  imputation String   @default("")

  /// Date de signature du bon de commande. La MENTION qui l'accompagnait
  /// (« envoyé par courrier en AR ») a été retirée : elle redisait la même
  /// chose de douze fiches sur dix-neuf, et le mode d'envoi d'un bon signé
  /// n'apprend rien qu'on vienne chercher dans un inventaire.
  bonCommandeLe DateTime? @map("bon_commande_le") @db.Date

  /// Code remis par l'autorité, à garder sous la main le jour où il faut agir
  /// vite : il invalide le certificat (perte, vol, départ du titulaire). Le
  /// code de RETRAIT qui l'accompagnait a été retiré : aucune fiche n'en avait,
  /// et il ne sert qu'à l'installation — un geste qui ne passe pas par
  /// l'inventaire.
  ///
  /// C'est un SECRET OPÉRATOIRE : révoquer le certificat d'un élu bloque ses
  /// signatures. Il n'est donc ni lu ni écrit pour un compte lecteur — la
  /// garde est côté serveur (le service ne le met pas dans son `select`), pas
  /// seulement dans l'affichage.
  codeRevocation String @default("") @map("code_revocation")

  statut         StatutCertificat @default(valide)
  /// Date de fin pour laquelle le rappel a déjà été envoyé (anti-doublon du
  /// cron ; remise à null quand la date change). Même mécanique que les marchés.
  rappelEnvoyeLe DateTime?        @map("rappel_envoye_le") @db.Date
  notes          String           @default("")

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  // Aucun de ces trois rattachements n'est propriétaire du certificat :
  // supprimer un service ou un serveur ne doit pas emporter la trace d'un
  // certificat qui, lui, a bel et bien été payé et délivré.
  fournisseur Editeur?            @relation("CertificatFournisseur", fields: [fournisseurId], references: [id], onDelete: SetNull)
  service     ServiceUtilisateur? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  serveur     Serveur?            @relation(fields: [serveurId], references: [id], onDelete: SetNull)
  /// Attestation de l'autorité, bon de commande signé, recueil d'identité.
  documents   Document[]

  @@index([fournisseurId])
  @@index([serviceId])
  @@index([serveurId])
  @@index([dateFin])
  @@map("certificats")
}

// ============================================================
//  Tâches récurrentes
// ============================================================

/// Rythme d'une tâche. `personnalisee` s'accompagne de `moisPersonnalises` ;
/// `ponctuelle` = une seule occurrence (la complétion clôt la tâche).
enum Periodicite {
  mensuelle
  trimestrielle
  semestrielle
  annuelle
  personnalisee
  ponctuelle
}

enum StatutTache {
  active
  en_pause
  terminee
}

/// Tâche d'exploitation à refaire régulièrement sur un logiciel : mise à jour,
/// renouvellement de contrat, purge, revue des comptes, certificat…
model TacheRecurrente {
  id                Int         @id @default(autoincrement())
  logicielId        Int         @map("logiciel_id")
  typeTacheId       Int?        @map("type_tache_id")
  titre             String
  description       String      @default("")
  periodicite       Periodicite @default(annuelle)
  /// Intervalle en mois quand periodicite = personnalisee (1..120).
  moisPersonnalises Int?        @map("mois_personnalises") @db.SmallInt

  /// Prochaine date à laquelle la tâche doit être FAITE. Recalculée à chaque
  /// complétion, ancrée sur l'échéance prévue (pas la date de complétion) —
  /// une tâche faite en retard ne décale pas tout le calendrier.
  prochaineEcheance DateTime    @map("prochaine_echeance") @db.Date
  statut            StatutTache @default(active)

  // Assignation : un compte de l'app OU un nom libre (personne hors app).
  assigneUserId String? @map("assigne_user_id")
  assigneLibre  String  @default("") @map("assigne_libre")

  /// Délai de rappel spécifique (jours avant échéance) ; null = valeur globale
  /// (app_config tache.rappelJoursAvant).
  rappelJoursAvant Int?      @map("rappel_jours_avant") @db.SmallInt
  /// Échéance pour laquelle le rappel a déjà été envoyé (anti-doublon : un seul
  /// mail par occurrence, remis à null au recalcul de l'échéance).
  rappelEnvoyePour DateTime? @map("rappel_envoye_pour") @db.Date

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  logiciel   Logiciel         @relation(fields: [logicielId], references: [id], onDelete: Cascade)
  typeTache  TypeTache?       @relation(fields: [typeTacheId], references: [id], onDelete: SetNull)
  assigne    User?            @relation(fields: [assigneUserId], references: [id], onDelete: SetNull)
  executions TacheExecution[]

  @@index([logicielId])
  @@index([typeTacheId])
  @@index([assigneUserId])
  @@index([statut, prochaineEcheance])
  @@map("taches_recurrentes")
}

/// Historique : une ligne par occurrence réalisée. L'acteur est DÉNORMALISÉ
/// (pattern AuditLog) : l'historique survit à la suppression du compte.
model TacheExecution {
  id             Int      @id @default(autoincrement())
  tacheId        Int      @map("tache_id")
  echeancePrevue DateTime @map("echeance_prevue") @db.Date
  faitLe         DateTime @default(now()) @map("fait_le") @db.Timestamptz
  faitParId      String?  @map("fait_par_id")
  faitParLabel   String   @default("") @map("fait_par_label")
  commentaire    String   @default("")

  tache TacheRecurrente @relation(fields: [tacheId], references: [id], onDelete: Cascade)

  @@index([tacheId])
  @@index([faitLe])
  @@map("taches_executions")
}

// ============================================================
//  Documents (pièces jointes)
// ============================================================

/// Pièce jointe d'un logiciel OU d'un éditeur (exactement un parent — contrainte
/// CHECK `num_nonnulls(logiciel_id, editeur_id) = 1` ajoutée en SQL dans la
/// migration, Prisma ne sachant pas l'exprimer).
///
/// Le fichier vit sur disque (ATTACHMENTS_DIR) sous `nomStockage` = <uuid>.<ext>
/// — JAMAIS le nom fourni par le client : la traversée de chemin est impossible
/// par construction, et la ligne en base est la seule porte d'accès (téléchargement
/// par id).
model Document {
  id             Int  @id @default(autoincrement())
  logicielId     Int? @map("logiciel_id")
  editeurId      Int? @map("editeur_id")
  /// Rattachement à une PIÈCE de contrat : la décision municipale et le contrat
  /// signé se lisent alors dans la pièce qu'ils attestent, sous leur marché,
  /// dans l'onglet Contrats/Marchés du logiciel.
  pieceContratId Int? @map("piece_contrat_id")
  /// Rattachement à un devis : le PDF remis par le fournisseur se lit alors
  /// sous son devis, dans l'onglet Devis du logiciel.
  devisId        Int? @map("devis_id")
  /// Rattachement à un certificat : l'attestation de l'autorité, le bon de
  /// commande signé, le formulaire de recueil d'identité.
  certificatId   Int? @map("certificat_id")
  categorieId    Int? @map("categorie_id")

  nomOriginal String @map("nom_original")
  nomStockage String @unique @map("nom_stockage")
  mime        String
  taille      Int

  // Déposant DÉNORMALISÉ (comme AuditLog) : l'historique survit au compte.
  deposeParId    String? @map("depose_par_id")
  deposeParLabel String  @default("") @map("depose_par_label")

  createdAt DateTime @default(now()) @db.Timestamptz

  logiciel     Logiciel?          @relation(fields: [logicielId], references: [id], onDelete: Cascade)
  editeur      Editeur?           @relation(fields: [editeurId], references: [id], onDelete: Cascade)
  pieceContrat PieceContrat?      @relation(fields: [pieceContratId], references: [id], onDelete: Cascade)
  devis        Devis?             @relation(fields: [devisId], references: [id], onDelete: Cascade)
  certificat   Certificat?        @relation(fields: [certificatId], references: [id], onDelete: Cascade)
  categorie    CategorieDocument? @relation(fields: [categorieId], references: [id], onDelete: SetNull)

  @@index([logicielId])
  @@index([editeurId])
  @@index([pieceContratId])
  @@index([devisId])
  @@index([certificatId])
  @@index([categorieId])
  @@map("documents")
}

// ============================================================
//  Infrastructure applicative
// ============================================================

/// Réglages éditables depuis l'administration (SMTP, LDAP, seuils de rappel,
/// horaires cron…), avec repli sur les variables d'environnement dans le code.
model AppConfig {
  key   String  @id @map("cfg_key")
  value String? @map("cfg_value")

  @@map("app_config")
}

// Journal des actions PRIVILÉGIÉES (création de compte, changement de rôle,
// modification SMTP/LDAP, suppressions, dépôts de documents…).
// L'acteur est DÉNORMALISÉ (libellé + rôle au moment de l'acte) : le journal
// doit rester lisible après suppression du compte — d'où l'absence de FK.
model AuditLog {
  id         Int      @id @default(autoincrement())
  at         DateTime @default(now()) @db.Timestamptz
  action     String
  actorId    String?  @map("actor_id")
  actorLabel String   @default("") @map("actor_label")
  actorRole  String   @default("") @map("actor_role")
  target     String?
  details    Json?
  ip         String?

  @@index([at])
  @@index([action])
  @@index([actorId])
  @@map("audit_log")
}

// File d'attente des e-mails en échec (envoi best-effort) : conservés pour
// pouvoir les renvoyer depuis Administration › Messagerie. Pas de FK.
model FailedMail {
  id          Int      @id @default(autoincrement())
  toAddr      String   @map("to_addr")
  subject     String   @default("")
  html        String   @default("")
  text        String   @default("")
  error       String   @default("")
  attempts    Int      @default(1) @db.SmallInt
  createdAt   DateTime @default(now()) @db.Timestamptz
  lastTriedAt DateTime @default(now()) @map("last_tried_at") @db.Timestamptz

  @@index([createdAt])
  @@map("failed_mails")
}

// Gabarits d'e-mails éditables (interpolation {{var}}). La CLÉ fait contrat avec
// le code (chaque gabarit correspond à un point d'envoi précis) ; le contenu est
// éditable en Administration › Messagerie. Repli sur DEFAULT_TEMPLATES du code
// quand subject/html sont vides. (Simplifié de culturesa : pas de portée service.)
model MailTemplate {
  key         String   @id
  label       String   @default("")
  description String   @default("")
  subject     String   @default("")
  html        String   @default("")
  builtin     Boolean  @default(false)
  position    Int      @default(0) @db.SmallInt
  createdAt   DateTime @default(now()) @db.Timestamptz

  @@map("mail_templates")
}
