# ════════════════════════════════════════════════════════════════════════════
#  SoftInventory — variables d'environnement
#  Copier ce fichier en `.env` et renseigner les valeurs.
# ════════════════════════════════════════════════════════════════════════════

# ── Application ──────────────────────────────────────────────────────────────
# Domaine(s) public(s) de l'app (Server Actions), séparés par des virgules.
APP_DOMAIN=softinventory.exemple.fr
# URL publique complète : c'est elle qui part dans les liens des e-mails
# (réinitialisation de mot de passe, rappels d'échéance). L'adresse par laquelle
# les gens ATTEIGNENT l'application, donc — pas celle du poste qui l'héberge :
# un courriel se lit ailleurs que là où il a été demandé, et « localhost » n'y
# mène nulle part. En dev sur un réseau, mettre l'IP du poste serveur.
APP_URL=https://softinventory.exemple.fr
NEXT_PUBLIC_APP_URL=https://softinventory.exemple.fr

# ── Base de données ──────────────────────────────────────────────────────────
POSTGRES_USER=softinventory
POSTGRES_PASSWORD=change-me
POSTGRES_DB=softinventory
# En dev local hors Docker :
# DATABASE_URL=postgresql://softinventory:dev@localhost:5432/softinventory?schema=public

# ── Authentification ─────────────────────────────────────────────────────────
# Secret de signature des sessions : longue chaîne aléatoire (openssl rand -hex 32).
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://softinventory.exemple.fr
# Origines supplémentaires de confiance (anti-CSRF), séparées par des virgules.
TRUSTED_ORIGINS=
# true UNIQUEMENT pour un accès en HTTP sur réseau interne de confiance :
# le cookie de session part alors sans l'attribut Secure.
ALLOW_INSECURE_COOKIES=false

# Compte administrateur initial, créé par `pnpm db:init` (≥ 12 caractères).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── SMTP (repli : la configuration en base, Administration › Messagerie, prime) ─
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=SoftInventory <no-reply@collectivite.fr>

# ── Cron ─────────────────────────────────────────────────────────────────────
# Secret partagé entre le conteneur cron et l'app (en-tête x-cron-secret).
# Sans lui, les routes /api/cron/* refusent tout (fail closed).
CRON_SECRET=

# ── Pièces jointes ───────────────────────────────────────────────────────────
# Répertoire de stockage des documents (volume Docker ./attachments:/attachments).
ATTACHMENTS_DIR=attachments

# ── Accès réseau au serveur de développement ─────────────────────────────────
# Hôtes (SANS le port, séparés par des virgules) autorisés à demander les assets
# de dev depuis un AUTRE poste — ex. « 192.168.1.20 ». Next 16 les refuse sinon,
# et la page arrive sans styles ni rechargement à chaud. Vide en local, sans
# effet en production.
#
# Le JOKER est admis, segment par segment : « 192.168.*.* » couvre tout le
# réseau local et survit à un bail DHCP qui change l'adresse du poste — sans
# quoi le blocage revient sans prévenir le jour où l'IP bouge. Plus large qu'une
# adresse précise : à réserver à un réseau de confiance.
#
# TOUTE MODIFICATION EXIGE DE RELANCER le serveur de dev : la configuration Next
# est lue au démarrage, pas à chaud.
DEV_ORIGINS=
